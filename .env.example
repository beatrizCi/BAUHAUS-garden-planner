# ---------- API ----------
PORT=3000
# sqlite (default, zero setup) or postgres (docker compose up -d db)
DB_TYPE=sqlite
SQLITE_PATH=data/garten.sqlite
# DB_TYPE=postgres
# DATABASE_URL=postgres://garten:garten@localhost:5432/garten
UPLOAD_DIR=uploads
# CORS_ORIGIN=http://localhost:5173

# ---------- Object detection (Hugging Face) ----------
# Without a token, detection is off and users mark objects with the brush.
HF_TOKEN=
HF_SEGMENTATION_MODEL=nvidia/segformer-b0-finetuned-ade-512-512
# HF_PROVIDER=hf-inference

# ---------- Object removal (generative inpainting) ----------
# Picked automatically: gemini (if GEMINI_API_KEY) → hf-endpoint (if HF_INPAINT_ENDPOINT) → local fill.
# INPAINT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Custom HF Inference Endpoint running LaMa / SDXL-inpainting (see README for the contract)
HF_INPAINT_ENDPOINT=
# HF_INPAINT_PROMPT=empty garden, natural continuation of the surrounding ground, photorealistic

# ---------- AI product suggestions (Claude) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
